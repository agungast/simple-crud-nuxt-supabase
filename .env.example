# ==============================================================================
# TaktVibe - contoh konfigurasi lingkungan
#
# Salin file ini menjadi `.env` lalu isi dengan nilai milik Anda:
#     cp .env.example .env
#
# JANGAN pernah commit file `.env` yang sudah terisi. `.env` sudah masuk
# .gitignore.
#
# Nilai diambil dari: Project Settings > API di dashboard Supabase.
# ==============================================================================

# URL project Supabase, contoh: https://abcdefghijklm.supabase.co
NUXT_PUBLIC_SUPABASE_URL=

# Kunci API anon / publishable
NUXT_PUBLIC_SUPABASE_KEY=

# ==============================================================================
# CATATAN KEAMANAN
#
# - NUXT_PUBLIC_SUPABASE_KEY adalah anon key. Kunci ini memang aman
#   dipublikasikan ke browser karena keamanan sebenarnya berada di Row Level
#   Security (RLS) pada tabel dan storage bucket.
#
# - JANGAN memakai service_role key di kode frontend. Kunci ini melewati RLS
#   sepenuhnya; begitu bocor, seluruh database bisa dibaca dan dihapus.
#   Service role hanya boleh dipakai di Edge Function / script server-side
#   seperti supabase/functions/backup-todos.
# ==============================================================================